diff --git a/engine/src/graph_trace.rs b/engine/src/graph_trace.rs
new file mode 100644
index 0000000..879037c
--- /dev/null
+++ b/engine/src/graph_trace.rs
@@ -0,0 +1,95 @@
+//! Opt-in, CPU-only main graph admission diagnostics. No cache policy changes.
+use std::collections::BTreeMap;
+use std::fs::{File, OpenOptions};
+use std::io::{BufWriter, Write};
+use std::path::Path;
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+const STEPS: u64 = 4096;
+const BYTES: usize = 4 * 1024 * 1024;
+const KEYS: usize = 1024;
+const LABELS: [&str; 7] = ["hit", "warm", "capture", "budget", "full", "failure", "forced"];
+
+pub(crate) struct GraphTrace {
+    gpu: usize,
+    origin: Instant,
+    out: BufWriter<File>,
+    bytes: usize,
+    steps: u64,
+    counts: BTreeMap<(usize, usize), [u64; 7]>,
+    pending: Vec<String>,
+    failed: bool,
+}
+impl GraphTrace {
+    /// Value is a fresh output directory; absent, empty or 0 leaves this fully off.
+    pub(crate) fn from_env(gpu: usize) -> Option<Self> {
+        let dir = std::env::var_os("VOLTA_GRAPH_TRACE")?;
+        if dir.is_empty() || dir == "0" { return None; }
+        match Self::open(Path::new(&dir), gpu) {
+            Ok(x) => Some(x),
+            Err(e) => { eprintln!("GPU{gpu}: graph trace disabled: {e}"); None }
+        }
+    }
+    fn open(dir: &Path, gpu: usize) -> std::io::Result<Self> {
+        std::fs::create_dir_all(dir)?;
+        let out = OpenOptions::new().write(true).create_new(true).open(dir.join(format!("gpu{gpu}.jsonl")))?;
+        let wall_epoch_ns = SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos();
+        let origin = Instant::now();
+        let mut x = Self { gpu, origin, out: BufWriter::with_capacity(64 * 1024, out), bytes: 0, steps: 0,
+            counts: BTreeMap::new(), pending: Vec::with_capacity(256), failed: false };
+        x.line(&format!("{{\"kind\":\"header\",\"version\":2,\"wall_epoch_ns\":{wall_epoch_ns},\"gpu\":{gpu},\"step_limit\":{STEPS},\"file_byte_limit\":{BYTES},\"labels\":{LABELS:?},\"phase_hint_only\":true}}"));
+        Ok(x)
+    }
+    fn line(&mut self, s: &str) {
+        if self.failed || self.bytes + s.len() + 1 > BYTES { return; }
+        if writeln!(self.out, "{s}").is_err() { self.failed = true; } else { self.bytes += s.len() + 1; }
+    }
+    pub(crate) fn record(&mut self, key: (usize, usize), decision: &'static str,
+        mut residents: Vec<[usize; 2]>, full: bool, limit: usize, capture_ns: u128, host_enqueue_backpressure_ns: u128) {
+        self.steps += 1;
+        let ix = LABELS.iter().position(|&s| s == decision).expect("graph trace label");
+        if self.counts.contains_key(&key) || self.counts.len() < KEYS {
+            self.counts.entry(key).or_default()[ix] += 1;
+        }
+        if self.steps <= STEPS {
+            residents.sort_unstable();
+            let resident_count = residents.len();
+            residents.truncate(16);
+            let (t, bucket) = key;
+            let elapsed_ns = self.origin.elapsed().as_nanos();
+            self.pending.push(format!("{{\"kind\":\"step\",\"gpu\":{},\"seq\":{},\"t\":{t},\"bucket\":{bucket},\"decision\":\"{decision}\",\"small_t_hint\":{},\"resident_count\":{resident_count},\"resident_keys\":{residents:?},\"resident_keys_truncated\":{},\"full\":{full},\"limit\":{limit},\"capture_ns\":{capture_ns},\"elapsed_ns\":{elapsed_ns},\"host_enqueue_backpressure_ns\":{host_enqueue_backpressure_ns}}}", self.gpu, self.steps, (1..=9).contains(&t), resident_count > 16));
+        }
+        if self.steps % 64 == 0 && self.steps <= STEPS { self.snapshot(); }
+    }
+    fn snapshot(&mut self) {
+        for s in std::mem::take(&mut self.pending) { self.line(&s); }
+        // Fixed key cap and file byte cap keep both memory and output bounded.
+        let rows: Vec<_> = self.counts.iter().map(|(&(t,b), c)| format!("[{t},{b},{c:?}]")).collect();
+        self.line(&format!("{{\"kind\":\"summary\",\"gpu\":{},\"observed_steps\":{},\"trace_steps\":{},\"trace_truncated\":{},\"counter_key_limit\":{KEYS},\"counts\":[{}]}}", self.gpu, self.steps, self.steps.min(STEPS), self.steps > STEPS, rows.join(",")));
+        if self.out.flush().is_err() { self.failed = true; }
+    }
+}
+impl Drop for GraphTrace { fn drop(&mut self) { self.snapshot(); } }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bounded_records_and_final_counts() {
+        let dir = std::env::temp_dir().join(format!("volta-graph-trace-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        let mut trace = GraphTrace::open(&dir, 3).unwrap();
+        assert!(GraphTrace::open(&dir, 3).is_err()); // Never overwrite a receipt.
+        for i in 0..5000 { trace.record((6,8192), if i%2==0 {"hit"} else {"budget"}, vec![[64,256],[64,512],[64,1024],[64,2048]], false, 4, 0, 123); }
+        assert!(trace.pending.is_empty());
+        assert_eq!(trace.counts[&(6,8192)][0], 2500);
+        drop(trace);
+        let raw = std::fs::read_to_string(dir.join("gpu3.jsonl")).unwrap();
+        assert_eq!(raw.lines().filter(|s|s.contains("\"kind\":\"step\"")).count(), 4096);
+        assert!(raw.contains("\"observed_steps\":5000"));
+        assert!(raw.contains("\"trace_truncated\":true"));
+        assert!(raw.len() < BYTES);
+        if let Some(p) = std::env::var_os("VOLTA_TRACE_TEST_RECEIPT") { std::fs::write(p, &raw).unwrap(); }
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+}
